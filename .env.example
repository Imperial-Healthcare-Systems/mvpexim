# Copy to .env.local and fill in. Nothing here is required to run the site
# locally — each feature stays inert until its variables are set.

# --- Enquiry form delivery -------------------------------------------------
# Without these two, POST /api/enquiry returns 503 and the form tells the
# visitor to call or WhatsApp instead. It never shows a false success.
#
# 1. Create an account at resend.com and verify the mvpexim.com domain.
# 2. Paste the API key below.
RESEND_API_KEY=

# Must be an address on the verified domain — Gmail addresses will be rejected
# as a sender by Resend.
ENQUIRY_FROM_EMAIL=enquiries@mvpexim.com

# Where enquiries land. Defaults to siteConfig.email if unset.
ENQUIRY_TO_EMAIL=mvpimpex@gmail.com

# --- Google Analytics 4 ----------------------------------------------------
# No tag is emitted at all until this is set.
NEXT_PUBLIC_GA_ID=
